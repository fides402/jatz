<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- A single bold "J" stroke, cream on dark -- one simple glyph, no
         repeating pattern (the earlier concentric-rings vinyl read as an
         optical/hypnotic spiral, not a record). Drawn as one open path with
         a thick round-capped stroke rather than a filled shape, so the curve
         stays smooth with no bezier-math risk. -->
    <path
        android:strokeColor="#EDE3D0"
        android:strokeWidth="15"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M62,29 L62,66 Q62,79 47,79" />
</vector>
